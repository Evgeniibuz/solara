# ── SOLARA server config ──
# Copy this file to ".env" and fill in your keys, OR set these as real
# environment variables in your host (Railway / Vercel / Fly / VPS).

# Required for REAL image generation. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional ────────────────────────────────────────────────
# Image model used on OpenRouter for the actual generation (default = Gemini 2.5 Flash Image).
# Note: the model NAME shown on the site is whatever the user picks in the
# render console (FLUX / SDXL / SD 3.5 / Juggernaut). This var is only the
# real backend model OpenRouter runs.
RENDER_MODEL=google/gemini-2.5-flash-image

# Spend protection (~$0.04 per image). Tune to your budget.
RENDER_DAILY_CAP=400
RENDER_IP_DAILY_CAP=25

# Force the paid render path OFF even if a key is set (true/false)
RENDER_LOCKED=false

# Your public URL (sent to OpenRouter as referer; cosmetic)
PUBLIC_URL=http://localhost:3000

# Port (do NOT set on Railway/Vercel — they inject it)
PORT=3000

# ── Token data (LIVE price / market cap / supply) ──────────
# Helius API key (server-side). Get one at https://dashboard.helius.dev
HELIUS_API_KEY=

# Your SPL token mint — set this AFTER your token launches.
# Price, market cap and supply are pulled from Helius for this mint.
TOKEN_MINT=

# Optional: override circulating supply used for market cap (else on-chain supply)
# CIRCULATING_SUPPLY=182400000
